# LangeOS x86_64 (só p/ teste rápido no PC com KVM): somado a lange.config. tinyconfig x86 é 32-bit.
CONFIG_64BIT=y
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_ACPI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
# binários 32-bit do vendor x86 (HAL de áudio); equivalente ao COMPAT do arm64
CONFIG_IA32_EMULATION=y
